{
  "name": "okfx-workspace",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Developer toolkit for Open Knowledge Format bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node packages/cli/scripts/make-executable.mjs",
    "check:okf": "node scripts/check-okf.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "clean": "pnpm -r --if-present run clean",
    "test": "pnpm test:unit && pnpm test:performance",
    "test:performance": "vitest run packages/core/test/performance.test.ts",
    "test:unit": "vitest run --exclude packages/core/test/performance.test.ts",
    "typecheck": "tsc -b tsconfig.json",
    "okf": "okf"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@okfxjs/core": "workspace:*",
    "@types/node": "^22.20.0",
    "commitizen": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
