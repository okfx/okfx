{
  "name": "okfx",
  "version": "0.1.0",
  "private": true,
  "description": "Developer toolkit for Open Knowledge Format bundles.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node packages/cli/scripts/make-executable.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json",
    "okf": "node_modules/.bin/okf"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
