{
  "name": "okfx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "Developer toolkit for Open Knowledge Format bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node packages/cli/scripts/make-executable.mjs",
    "clean": "pnpm -r --if-present run clean",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json",
    "okf": "okf"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
